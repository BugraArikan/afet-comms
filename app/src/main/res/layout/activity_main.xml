<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMain"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        app:menu="@menu/menu_family_main"
        app:title="@string/family_main_title"
        app:titleTextColor="@color/md_theme_on_surface" />

    <TextView
        android:id="@+id/txtMainHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="@string/family_main_hint"
        android:textColor="@color/on_surface_variant"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSos"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:backgroundTint="@color/sos_button_bg"
        android:gravity="center"
        android:minHeight="160dp"
        android:text="@string/family_sos_button"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="34sp"
        android:textStyle="bold"
        app:cornerRadius="22dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSafe"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:layout_weight="1"
        android:backgroundTint="@color/safe_button_bg"
        android:gravity="center"
        android:minHeight="140dp"
        android:text="@string/family_safe_button"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        app:cornerRadius="22dp" />

</LinearLayout>
